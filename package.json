{
  "name": "dsh-unrestricted",
  "version": "0.1.4",
  "private": true,
  "description": "Toggleable unrestricted mode for the current DSH master: fuses execution rules into the active standard, ptc, cordis, minimal, and subagent prompts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/yexi-by/dsh-unrestricted.git"
  },
  "homepage": "https://github.com/yexi-by/dsh-unrestricted#readme",
  "bugs": "https://github.com/yexi-by/dsh-unrestricted/issues",
  "type": "module",
  "main": "src/node.js",
  "exports": {
    ".": "./src/node.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "docs",
    "cordis.patch.yml",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-connection",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-renderer",
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-settings-plugins"
      ]
    }
  },
  "scripts": {
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/*.spec.mjs",
    "dump-prompts": "node tools/dump-prompts.mjs --repo ../../deepseek-harness --out tests/fixtures"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@types/react": "~18.3.1",
    "@types/react-dom": "^18.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "tsdown": "^0.22.2",
    "typescript": "^5.6.0"
  }
}
